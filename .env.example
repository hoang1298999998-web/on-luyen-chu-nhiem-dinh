# Lấy các giá trị này trong Supabase Dashboard > Project Settings > API

# Project URL (Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# anon / public key (Settings > API > Project API keys > anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxx...

# service_role key (Settings > API > Project API keys > service_role)
# ⚠️ KHÔNG BAO GIỜ thêm tiền tố NEXT_PUBLIC_ cho biến này, và không commit giá trị thật lên GitHub.
# Biến này chỉ được dùng ở phía server (API routes) để chấm điểm thi thật & import câu hỏi.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxx...
